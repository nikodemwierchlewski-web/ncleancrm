# Documentation only: Spring does NOT automatically load this file.
# Set these in the process environment. Use a NEW, empty CRM database only.
CRM_DB_URL=jdbc:postgresql://127.0.0.1:5432/nclean_crm
CRM_DB_USERNAME=
CRM_DB_PASSWORD=
CRM_ADMIN_USERNAME=
# BCrypt hash, not a plain-text password. Generate locally; do not commit it.
CRM_ADMIN_PASSWORD_HASH=
