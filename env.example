# Documentation only: Spring does NOT automatically load this file.
# For local Compose setup, use scripts/Initialize-Local.ps1 and profile "local".
# That profile imports ignored .local/application-local.properties.
# For manual configuration, set these in the process environment.
# Use a NEW, empty CRM database only. Never use the CMS database.
CRM_DB_URL=jdbc:postgresql://127.0.0.1:55433/nclean_crm
CRM_DB_USERNAME=crm_dev
CRM_DB_PASSWORD=
CRM_ADMIN_USERNAME=
# BCrypt hash, not a plain-text password. Generate locally; do not commit it.
CRM_ADMIN_PASSWORD_HASH=
