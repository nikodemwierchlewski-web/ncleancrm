# Template only. Create /etc/nclean-crm/secrets.properties outside the checkout.
# Owner root:nclean-crm, mode 0640; never commit the filled file.
# Separate PostgreSQL database and roles. These are intentionally unusable placeholders.
spring.datasource.url=jdbc:postgresql://127.0.0.1:5432/nclean_crm
spring.datasource.username=REPLACE_RUNTIME_ROLE
spring.datasource.password=REPLACE_RUNTIME_PASSWORD
spring.flyway.url=jdbc:postgresql://127.0.0.1:5432/nclean_crm
spring.flyway.user=REPLACE_MIGRATION_ROLE
spring.flyway.password=REPLACE_MIGRATION_PASSWORD
crm.admin.username=REPLACE_OWNER_LOGIN
crm.admin.password-hash=REPLACE_BCRYPT_HASH
