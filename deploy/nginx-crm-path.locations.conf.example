# Include INSIDE the EXISTING HTTPS server block for nclean.pl.
# Keep its TLS certificate, public website upstream and all other locations.
# Requires an application actually configured AND adapted for context-path=/crm.
# Current audit: NOT READY for production; see SAME-DOMAIN-AUDIT.md.
location = /crm {
    access_log /var/log/nginx/nclean-crm-access.log nclean_crm_path;
    return 308 /crm/$is_args$args;
}
location = /crm/login {
    access_log /var/log/nginx/nclean-crm-access.log nclean_crm_path;
    limit_req zone=nclean_crm_path_login burst=5 nodelay;
    limit_req_status 429;
    include /etc/nginx/snippets/nclean-crm-path-proxy.conf;
}
location ^~ /crm/ {
    access_log /var/log/nginx/nclean-crm-access.log nclean_crm_path;
    include /etc/nginx/snippets/nclean-crm-path-proxy.conf;
}
